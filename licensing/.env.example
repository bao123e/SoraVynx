# Configure on your private bot host. Never commit .env or private PEM.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
DISCORD_OWNER_ID=
LICENSE_PRIVATE_KEY_FILE=./secrets/issuer-private.pem

# Optional for CLI; required by bot: fine-grained token, website repo only, Contents write.
GITHUB_TOKEN=

# SePay webhook: choose API Key authentication and copy THIS shared key into SePay.
# This is NOT a SePay user API token and NOT your banking password.
SEPAY_WEBHOOK_API_KEY=
SEPAY_ACCOUNT_NUMBER=
SEPAY_GATEWAY=BIDV
PAYMENT_ADMIN_KEY=
PAYMENT_DB_FILE=./secrets/payments.sqlite
PUBLIC_BASE_URL=
